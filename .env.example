# ---------------------------------------------------------------------------
# AFTERMATH environment configuration
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# --- Walrus Memory (MemWal) ------------------------------------------------
# Mainnet relayer (production). Do NOT point production writes at the staging
# relayer (https://relayer-staging.memory.walrus.xyz).
MEMWAL_SERVER_URL="https://relayer.memory.walrus.xyz"

# MemWalAccount object ID on Sui mainnet (from memory.walrus.xyz playground).
MEMWAL_ACCOUNT_ID=""

# Ed25519 delegate private key (hex, optionally 0x-prefixed, or suiprivkey1...).
# Server-side only. Never expose to the browser.
MEMWAL_PRIVATE_KEY=""

# Default namespace for AFTERMATH memories.
MEMWAL_NAMESPACE="aftermath"

# Set to "1" to force the simulated (in-process) memory backend even when
# credentials are present. The UI always labels simulated state explicitly.
AFTERMATH_FORCE_MOCK_MEMORY=""

# --- Tatum Sui RPC ---------------------------------------------------------
# Primary interface: documented Sui Mainnet gRPC gateway. Sui Foundation has
# disabled JSON-RPC on Mainnet full nodes and documents gRPC as the replacement,
# so gRPC is the primary read interface.
TATUM_SUI_GRPC_URL="https://sui-mainnet-grpc.gateway.tatum.io"

# Fallback interface: Tatum's Sui gateway host, which now serves GraphQL at
# /graphql (it no longer serves JSON-RPC). Used only when the gRPC lookup cannot
# complete at all.
TATUM_SUI_GRAPHQL_URL="https://sui-mainnet.gateway.tatum.io/graphql"

# Tatum API key. Sent as the `x-api-key` header for both gRPC metadata and
# GraphQL. Server-side only.
TATUM_API_KEY=""

# Per-request timeout for a Sui lookup, in milliseconds.
TATUM_TIMEOUT_MS="12000"

# --- AI-assisted incident analysis (optional, free tier only) --------------
# AFTERMATH uses a language model only to *read* unfamiliar material and
# propose candidate mechanisms, missing evidence, and investigations. It never
# decides an outcome: the deterministic engine owns the evidence status,
# diagnosis, decision, and verification. The model's findings are grounded
# claim-by-claim against the submission; ungrounded claims are rejected.
#
# Provider: Groq (free tier), model: openai/gpt-oss-120b (131k context, Strict
# Structured Outputs). No paid provider or model is reachable from the app.
# Leave empty to run deterministic-only; the record states which was used.
GROQ_API_KEY=""

# Per-request ceiling for an AI reading, in milliseconds.
AFTERMATH_AI_TIMEOUT_MS="20000"

# --- AI verification endpoint (optional) -----------------------------------
# A read-only endpoint that proves a live deployment actually runs the model,
# without submitting an incident or writing anything. It FAILS CLOSED: leave
# this empty and POST /api/ai/verify returns 503 and never serves inference.
# Set it to a long random string to enable the endpoint, then call it with
# `Authorization: Bearer <token>`.
AFTERMATH_AI_VERIFY_TOKEN=""
# Fixed-window request cap per caller, and its window.
AFTERMATH_AI_VERIFY_MAX="5"
AFTERMATH_AI_VERIFY_WINDOW_MS="60000"

# --- Application -----------------------------------------------------------
# Durable audit index (PostgreSQL). When set, the incident index is stored in a
# shared database instead of a per-instance SQLite file, so records written by
# one request are visible to every serverless instance. Required for a durable
# demo on Vercel. On Vercel + Neon, `POSTGRES_URL` is provided automatically;
# any of DATABASE_URL / POSTGRES_URL / AFTERMATH_DATABASE_URL is accepted.
# Example (Neon): postgresql://user:password@ep-xxx.region.aws.neon.tech/aftermath?sslmode=require
DATABASE_URL=""

# Persistent SQLite file location for the incident index / audit history.
# Used only when DATABASE_URL is not set. On a read-only host this falls back to
# the OS temp directory, which is NOT shared between instances.
AFTERMATH_DB_PATH="./data/aftermath.db"

# Directory for the coding-demonstration test harness scratch space.
AFTERMATH_HARNESS_DIR="./data/harness"
