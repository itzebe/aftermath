# ---------------------------------------------------------------------------
# AFTERMATH environment configuration
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# --- Walrus Memory (MemWal) ------------------------------------------------
# Mainnet relayer (production). Do NOT point production writes at the staging
# relayer (https://relayer-staging.memory.walrus.xyz).
MEMWAL_SERVER_URL="https://relayer.memory.walrus.xyz"

# MemWalAccount object ID on Sui mainnet (from memory.walrus.xyz playground).
MEMWAL_ACCOUNT_ID=""

# Ed25519 delegate private key (hex, optionally 0x-prefixed, or suiprivkey1...).
# Server-side only. Never expose to the browser.
MEMWAL_PRIVATE_KEY=""

# Default namespace for AFTERMATH memories.
MEMWAL_NAMESPACE="aftermath"

# Set to "1" to force the simulated (in-process) memory backend even when
# credentials are present. The UI always labels simulated state explicitly.
AFTERMATH_FORCE_MOCK_MEMORY=""

# --- Tatum Sui RPC ---------------------------------------------------------
# Primary interface: documented Sui Mainnet gRPC gateway. Sui Foundation has
# disabled JSON-RPC on Mainnet full nodes and documents gRPC as the replacement,
# so gRPC is the primary read interface.
TATUM_SUI_GRPC_URL="https://sui-mainnet-grpc.gateway.tatum.io"

# Fallback interface: documented Sui Mainnet JSON-RPC gateway. Used only when
# the gRPC lookup cannot complete at all.
TATUM_SUI_RPC_URL="https://sui-mainnet.gateway.tatum.io"

# Tatum API key. Sent as the `x-api-key` request header (gRPC metadata) and
# `X-API-Key` for JSON-RPC. Server-side only.
TATUM_API_KEY=""

# Per-request timeout for a Sui lookup, in milliseconds.
TATUM_TIMEOUT_MS="12000"

# --- Application -----------------------------------------------------------
# Persistent SQLite file location for the incident index / audit history.
AFTERMATH_DB_PATH="./data/aftermath.db"

# Directory for the coding-demonstration test harness scratch space.
AFTERMATH_HARNESS_DIR="./data/harness"
